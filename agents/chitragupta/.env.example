# agents/chitragupta/.env
#
# This is the canonical env file BRAHM loads secrets from at runtime
# (see brahm/shared/constants.py: ENV_FILE). GANESH also reads its
# Groq key from here, not from its own directory.
#
# Copy this file to agents/chitragupta/.env and fill in real values.
# Never commit the real .env — it's already in .gitignore.

# ── Required for the core SHANI -> GANESH pipeline ──────────────────────────

# Groq API key. Used by GANESH (document synthesis) and SHANI S5
# (knowledge extraction) via services/llm_service.py.
GROQ_API_KEY=

# Groq model string. As of Aug 2026, llama-3.3-70b-versatile is
# DEPRECATED (announced June 2026) -- confirm this still resolves before
# relying on it; Groq's recommended migration targets are
# openai/gpt-oss-120b or qwen/qwen3.6-27b.
GROQ_MODEL=llama-3.3-70b-versatile

# Which LLM GANESH's document generation should target. Separate from
# GROQ_MODEL -- check agents/ganesh/ganesh/llm_client.py if unsure how
# these two interact.
GANESH_LLM=

# NVIDIA NIM API key -- used by the coordinator (brahm/coordinator/) for
# plan generation (openai/gpt-oss-120b, reasoning_effort=low). Only
# needed if you're running the coordinator/dashboard layer.
NVIDIA_API_KEY=

# Materials Project API key -- used by pymatgen/mp-api for structure
# lookups in Vishwakarma workflows. Get one at https://next-gen.materialsproject.org/api
MP_API_KEY=

# Path to DocLayout-YOLO model weights, used by SHANI S4's vision-first
# extraction pipeline (tools/s4_vision/). If unset or the file is
# missing, S4 falls back to heuristic (non-vision) extraction --
# lower quality but the pipeline still runs.
DOCLAYOUT_YOLO_WEIGHTS=

# Embedding/NLP model name -- check agents/chitragupta/nlp/ and
# agents/shani/services/vector_db_service.py for exact usage; the
# project generally uses all-MiniLM-L6-v2 for FAISS vector search.
NLP_MODEL=all-MiniLM-L6-v2

# Standard Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Optional API key for X-API-Key auth on Chitragupta's FastAPI server
# (agents/chitragupta/api_server.py). Leave blank for local dev (auth
# disabled); set it if you're exposing :8003 beyond localhost.
API_KEY=


# ── Docker Compose only (docker-compose.yml) ────────────────────────────────
# These are NOT read by the app code itself -- they're substituted into
# docker-compose.yml at the host level. Set them in your shell or in a
# root-level .env that `docker compose` picks up automatically (compose
# reads ./.env by default, separate from this file).

# Set to true to enable Chitragupta's voice/whisper endpoints (pulls in
# openai-whisper + torch at import time -- see api/app.py). Default false
# keeps the container from paying that import cost when voice/Notion
# features aren't used.
ENABLE_VOICE_FEATURES=false

# Host path to your own Quantum ESPRESSO pseudopotential (.UPF) files,
# bind-mounted read-only into the vishwakarma container at /data/pseudo.
# No pseudopotentials ship in this repo (confirmed absent) -- source your
# own from pslibrary or SSSP. Defaults to ./agents/vishwakarma/pseudo if unset.
QE_PSEUDO_HOST_DIR=./agents/vishwakarma/pseudo


# ── Optional -- only needed for Chitragupta's legacy features ───────────────
# These belong to Chitragupta's earlier incarnation as a standalone
# voice-first personal habit/journal tracker (Notion-backed, Whisper
# voice input). That functionality is still wired into the live API
# (api/routers/databases.py, entries.py, voice.py all still import
# notion_client.py), but it is NOT used by the core SHANI -> GANESH
# research pipeline. Leave these blank unless you specifically want
# the Notion-journal / voice-logging endpoints to work.

# ── NOTION_TOKEN: currently REQUIRED, despite appearances ───────────────────
# CONFIRMED 2026-08-12 via a real container crash-loop: config/settings.py
# hard-raises EnvironmentError at import time if NOTION_TOKEN is unset --
# and that import chain gets pulled in by api/routers/databases.py, which
# api/app.py imports unconditionally. So even though Notion/voice are
# described below as "legacy, optional" features, the API process will not
# start at all without a NOTION_TOKEN set, regardless of whether you ever
# touch a Notion endpoint. This contradicts the framing in this file as
# written -- it's a real gap in the source, not a Docker-specific issue,
# and hasn't been fixed here (that's a code change, not a packaging one --
# left for a deliberate decision on whether to relax config/settings.py's
# check or make the Notion-dependent routers lazy the same way voice was
# made lazy this session).
#
# Until that's addressed: get a real token at
# https://www.notion.so/my-integrations, or set any non-empty placeholder
# string to get past the startup check if you don't need real Notion
# functionality -- anything that actually calls the Notion API will still
# fail later, but the server will at least start.
NOTION_TOKEN=

# Target Notion parent page ID for created databases
NOTION_PAGE_ID=

# Notion API version header, e.g. 2022-06-28
NOTION_VERSION=

# Whisper model size for voice transcription: tiny | base | small | medium | large
WHISPER_MODEL=base

# Cron-style schedule for the reminder/scheduler module
SCHEDULE_TIME=
