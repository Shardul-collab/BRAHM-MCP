# Root-level .env -- read automatically by `docker compose` for variable
# substitution in docker-compose.yml (the ${VAR} references). This is
# separate from agents/chitragupta/.env, which holds the actual app
# secrets (GROQ_API_KEY etc.) and is passed into containers via env_file:.
#
# Copy this to .env at the repo root:
#   cp .env.example .env

# Enable Chitragupta's voice/whisper endpoints. Default false -- see
# agents/chitragupta/.env.example for why this matters for image weight.
ENABLE_VOICE_FEATURES=false

# Host path to your own QE pseudopotential (.UPF) files, bind-mounted
# read-only into the vishwakarma container. No pseudopotentials ship in
# this repo -- source your own (pslibrary, SSSP).
QE_PSEUDO_HOST_DIR=./agents/vishwakarma/pseudo
